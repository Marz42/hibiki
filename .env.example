# HIBIKI M1 live-model credentials.
#
# Copy this file to `.env` and fill in the three values, or export them in your shell.
# `.env` is gitignored: it must never be committed, and nothing logs the key.
#
# Any OpenAI-compatible endpoint works, for example:
#   OpenAI         https://api.openai.com/v1                      gpt-4o-mini
#   DeepSeek       https://api.deepseek.com                       deepseek-chat
#   OpenRouter     https://openrouter.ai/api/v1                   (any tool-calling model)
#   Gemini compat  https://generativelanguage.googleapis.com/v1beta/openai/
#   local vLLM     http://127.0.0.1:8000/v1                       (your served model)
#   local Ollama   http://127.0.0.1:11434/v1                      qwen2.5:7b-instruct

HIBIKI_MODEL_BASE_URL=
HIBIKI_MODEL_API_KEY=
HIBIKI_MODEL=

# Optional: sandbox image used for shell.run (default hibiki-sandbox:py312).
# HIBIKI_SANDBOX_IMAGE=hibiki-sandbox:py312
